          <rect x="652" y="67" width="30" height="17" rx="8" fill="#FFFFFF" stroke="#A7F3D0" />
          <text x="667" y="79" text-anchor="middle" fill="#047857" font-size="10" font-weight="700">OK</text>

          <!-- Verify -KO-> Feedback -->
