    }

    function setIntakeMode(mode) {
      collectFormIntoDraft();
      STATE.intakeMode = mode;
      renderCockpit();
    }

    function loadPreset(key) {
      const preset = STATE.presets[key];
      if (!preset) return;
      STATE.draftProfile = JSON.parse(JSON.stringify(preset.profile));
      STATE.intakeSourceInfo = `Nạp mẫu: ${preset.label}`;
      renderCockpit();
      showToast(`Đã nạp nhanh ${preset.label}`, 'info');
    }

    function handleFileSelect(ev) {
      const file = ev.target.files?.[0];
      if (file) {
        document.getElementById('selected-file-label').textContent = `Đã chọn: ${file.name} (${(file.size / 1024).toFixed(1)} KB)`;
      }
    }

    async function runAiExtraction() {
      const btn = document.getElementById('btn-ai-extract');
      const fileInput = document.getElementById('intake-file-input');
      const rawText = document.getElementById('intake-raw-text')?.value || '';
      const file = fileInput?.files?.[0];
      if (!file && !rawText.trim()) {
        showToast('Vui lòng chọn tệp (.pdf/.docx/.txt) hoặc dán văn bản hồ sơ.', 'warning');
        return;
      }

      btn.disabled = true;
      btn.innerHTML = '<i data-lucide="loader-2" class="w-3.5 h-3.5 animate-spin"></i> Đang bóc tách...';
      lucide.createIcons();

      try {
        let res;
        if (file) {
          const formData = new FormData();
          formData.append('file', file);
          res = await apiFetch('/api/step1/extract', { method: 'POST', body: formData });
          STATE.intakeSourceInfo = `File tải lên: ${file.name}`;
        } else {
          res = await apiFetch('/api/step1/extract', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ raw_text: rawText }),
          });
          STATE.intakeSourceInfo = 'Văn bản tự do';
        }
        STATE.draftProfile = res.profile;
        STATE.rawExtractedText = res.raw_text || rawText;
        renderCockpit();
        showToast(`Bóc tách thành công (${res.extraction_source})!`, 'success');
      } catch (err) {
        showToast('Lỗi bóc tách: ' + err.message, 'error');
      } finally {
        btn.disabled = false;
      }
    }

    function collectFormIntoDraft() {
      const g = id => document.getElementById(id)?.value;
      if (!document.getElementById('f-company')) return STATE.draftProfile;
      const profile = {
        legal: {
          company_name: g('f-company'),
          tax_code: g('f-mst'),
          representative: g('f-rep'),
          phone: g('f-phone'),
          email: g('f-email'),
          business_license_years: parseInt(g('f-lic-years') || '2', 10),
          capital_billion_vnd: parseFloat(g('f-capital') || '1.5'),
        },
        location: {
          region: g('f-region'),
          province: g('f-province'),
          district: g('f-district'),
          address: g('f-address'),
          latitude: parseFloat(g('f-lat') || '21.0285'),
          longitude: parseFloat(g('f-lng') || '105.8542'),
          storefront_area_m2: parseFloat(g('f-store-area') || '60'),
          warehouse_area_m2: parseFloat(g('f-wh-area') || '60'),
          main_road_access: true,
        },
        commercial: {
          monthly_commitment_billion_vnd: parseFloat(g('f-commit') || '0.8'),
          requested_discount_pct: parseFloat(g('f-discount') || '16'),
          product_lines: String(g('f-products') || '').split(',').map(s => s.trim()).filter(Boolean),
          experience_years: parseInt(g('f-exp-years') || '2', 10),
          active_retail_channels: g('f-channels'),
        },
        warranty: {
          technicians_count: parseInt(g('f-ktv') || '0', 10),
          has_service_workshop: parseFloat(g('f-ws-area') || '0') > 0,
          workshop_area_m2: parseFloat(g('f-ws-area') || '0'),
          sla_commitment_hours: parseInt(g('f-sla') || '48', 10),
        },
        financial: {
          payment_term_days: parseInt(g('f-term') || '30', 10),
          credit_limit_requested_million_vnd: parseFloat(g('f-limit') || '300'),
          has_bank_guarantee: Boolean(document.getElementById('f-has-bg')?.checked),
          bank_guarantee_amount_million_vnd: parseFloat(g('f-bg-amt') || '0'),
        },
      };
      STATE.draftProfile = profile;
      return profile;
    }

    async function submitStep1Form() {
      const profile = collectFormIntoDraft();
      if (!profile.legal.company_name.trim()) {
        showToast('Vui lòng nhập Tên pháp nhân đối tác.', 'warning');
        return;
      }
      try {
        const res = await apiFetch('/api/step1/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            profile,
            intake_mode: STATE.intakeMode,
            source_info: STATE.intakeSourceInfo,
            raw_text: STATE.rawExtractedText,
          }),
        });
        STATE.activeDossier = res.dossier;
        STATE.dossiers = res.dossiers;
        STATE.analytics = res.analytics;
        STATE.cockpitStep = 2;
        renderAll();
        renderCockpit();
        showToast(`Đã lưu hồ sơ ${res.dossier.dossier_id} & hoàn tất đối chiếu Bước 2.`, 'success');
      } catch (err) {
        showToast(err.message, 'error');
      }
    }

    async function rerunStep2FromForm() {
      const profile = collectFormIntoDraft();
      try {
        const res = await apiFetch(`/api/dossiers/${STATE.activeDossier.dossier_id}/step2`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ profile }),
        });
        STATE.activeDossier = res.dossier;
        STATE.dossiers = res.dossiers;
        STATE.analytics = res.analytics;
        STATE.cockpitStep = 2;
        renderAll();
        renderCockpit();
        showToast('Đã cập nhật hồ sơ & chạy lại Bước 2.', 'success');
      } catch (err) {
        showToast(err.message, 'error');
      }
    }

    // ----------------- STEP 2: AI COMPLIANCE CHECK -----------------
    function renderStep2Html(d) {
      const comp = d.compliance_report || {};
      const dups = comp.duplicate_matches || [];
      const nearest = comp.nearest_partners || [];
      const checks = comp.policy_checks || [];

      const overallBadge = comp.overall_status === 'CRITICAL_VIOLATION'
        ? '<span class="px-3.5 py-1 rounded-full text-xs font-bold btn-glass-crimson text-white">Vi phạm chính sách</span>'
        : comp.overall_status === 'WARNING'
          ? '<span class="px-3.5 py-1 rounded-full text-xs font-bold btn-glass-amber text-white">Cần xem xét</span>'
          : '<span class="px-3.5 py-1 rounded-full text-xs font-bold btn-glass-green text-white">Đạt chuẩn</span>';

      return `
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h4 class="text-sm font-bold text-slate-900">Đối chiếu hồ sơ</h4>
          ${overallBadge}
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
          <div class="liquid-panel rounded-xl p-4 space-y-3">
            <h5 class="text-xs font-bold text-slate-900 flex items-center gap-2">
              <i data-lucide="fingerprint" class="w-4 h-4 text-blue-600"></i> 1. Trùng lặp &amp; Nợ xấu
            </h5>
            ${dups.length ? dups.map(m => `
              <div class="p-3.5 rounded-xl border ${m.is_bad_debt ? 'bg-rose-50 border-rose-200' : 'bg-amber-50 border-amber-200'} text-xs space-y-1">
                <div class="font-bold ${m.is_bad_debt ? 'text-rose-700' : 'text-amber-700'}">
                  ${m.is_bad_debt ? 'Nợ xấu' : 'Trùng đại lý'}: ${escapeHtml(m.company_name)}
                </div>
                <div class="text-slate-700">Trùng: <strong>${escapeHtml(m.matched_fields.join(', '))}</strong></div>
                <div class="text-[11px] text-slate-500">${escapeHtml(m.notes)}</div>
              </div>
            `).join('') : `
              <div class="p-3.5 rounded-xl bg-emerald-50 border border-emerald-200 text-xs text-emerald-700">
                Không trùng MST, SĐT hoặc người đại diện trong CSDL.
              </div>
            `}
          </div>

          <div class="liquid-panel rounded-xl p-4 space-y-3">
            <h5 class="text-xs font-bold text-slate-900 flex items-center gap-2">
              <i data-lucide="map-pinned" class="w-4 h-4 text-blue-600"></i> 2. Địa bàn (GPS)
            </h5>
            <div class="space-y-2 max-h-64 overflow-y-auto custom-scroll pr-1">
              ${nearest.map(n => `
                <div class="p-3 rounded-xl border ${n.is_radius_violation || n.is_exclusive_violation ? 'bg-rose-50 border-rose-200' : 'liquid-pill'} text-xs flex items-center justify-between gap-2">
                  <div>
                    <div class="font-semibold text-slate-900">${escapeHtml(n.partner_name)}</div>
                    <div class="text-[11px] text-slate-500">${escapeHtml(n.tier_level)} · ${escapeHtml(n.district)} · ${n.protection_radius_km} km</div>
                  </div>
                  <div class="text-right shrink-0">
                    <div class="font-bold tabular-nums ${n.is_radius_violation ? 'text-rose-600' : 'text-emerald-600'}">${n.distance_km} km</div>
                    ${n.is_exclusive_violation ? '<div class="text-[10px] font-bold text-rose-600">Độc quyền</div>' : (n.is_radius_violation ? '<div class="text-[10px] text-rose-600">Quá gần</div>' : '<div class="text-[10px] text-slate-500">Hợp lệ</div>')}
                  </div>
                </div>
              `).join('')}
            </div>
          </div>

          <div class="liquid-panel rounded-xl p-4 space-y-3">
            <h5 class="text-xs font-bold text-slate-900 flex items-center gap-2">
              <i data-lucide="scale" class="w-4 h-4 text-blue-600"></i> 3. Chính sách công nợ
            </h5>
            <div class="space-y-2">
              ${checks.map(c => {
                const style = c.status === 'CRITICAL_BREACH'
                  ? 'bg-rose-50 border-rose-200 text-rose-700'
                  : c.status === 'WARNING'
                    ? 'bg-amber-50 border-amber-200 text-amber-800'
                    : 'bg-emerald-50 border-emerald-200 text-emerald-700';
                return `
                  <div class="p-3 rounded-xl border ${style} text-xs">
                    <div class="font-bold">${escapeHtml(c.title)}</div>
                    <div class="text-[11px] opacity-90 mt-0.5">${escapeHtml(c.detail)}</div>
                  </div>
                `;
              }).join('')}
            </div>
          </div>
        </div>

        <div class="flex items-center justify-end gap-3 pt-2">
          <button onclick="jumpCockpitStep(3)" class="px-6 py-2.5 rounded-lg btn-glass-blue text-xs font-bold text-white flex items-center gap-2 transition">
            <span>Sang Bước 3 · Xác minh</span>
            <i data-lucide="arrow-right" class="w-4 h-4"></i>
          </button>
        </div>
      `;
    }

    // ----------------- STEP 3: CROSS-FUNCTIONAL VERIFICATION -----------------
    function renderStep3Html(d) {
      const vt = d.verification_tickets || {};
      const tickets = vt.tickets || {};
      const kd = tickets.commercial || { checklist: [], inputs: {} };
      const vh = tickets.operations || { checklist: [], inputs: {} };
