    function resetExcelUiState() {
      STATE.excelCleanPage = 1;
      STATE.excelVerifyPage = 1;
      STATE.excelKoPage = 1;
      STATE.excelCleanEdits = {};
      STATE.excelVerifyToggles = {};
      STATE.excelKoExcluded = {};
    }

    function setExcelCleanPage(p) {
      STATE.excelCleanPage = Math.max(1, p);
      renderExcelWorkflow();
    }

    function setExcelVerifyPage(p) {
      STATE.excelVerifyPage = Math.max(1, p);
      renderExcelWorkflow();
    }

    function setExcelKoPage(p) {
      STATE.excelKoPage = Math.max(1, p);
      renderExcelWorkflow();
    }

    function setKoRetryToggle(rowNum, checked) {
      STATE.excelKoExcluded[String(rowNum)] = !checked;
      const koRows = STATE.excelJob?.ko_rows || STATE.excelJob?.processed_rows || [];
      const el = document.getElementById('ko-retry-count');
      if (el) el.textContent = String(koRows.filter(ko => !STATE.excelKoExcluded[String(ko.row_num)]).length);
    }

    function bulkKoRetry(includeAll) {
      const koRows = STATE.excelJob?.ko_rows || STATE.excelJob?.processed_rows || [];
      koRows.forEach(ko => {
        STATE.excelKoExcluded[String(ko.row_num)] = !includeAll;
      });
      renderExcelWorkflow();
    }

    function setCleanField(rowNum, field, val) {
      const rows = STATE.excelJob?.cleaned_rows || [];
      const row = rows.find(r => Number(r.row_num) === Number(rowNum));
      if (!row) return;
      if (field === 'included') row.included = Boolean(val);
      else if (field === 'company_name') row.profile.legal.company_name = val;
      else if (field === 'tax_code') row.profile.legal.tax_code = val;
      else if (field === 'technicians_count') row.profile.warranty.technicians_count = Number(val || 0);
      else if (field === 'payment_term_days') row.profile.financial.payment_term_days = Number(val || 0);
      const editObj = STATE.excelCleanEdits[rowNum] || { row_num: rowNum };
      editObj[field] = field === 'included' ? Boolean(val) : val;
      STATE.excelCleanEdits[rowNum] = editObj;
    }

    function bulkCleanInclude(flag) {
      const rows = STATE.excelJob?.cleaned_rows || [];
      rows.forEach(r => {
        const nextVal = flag ? r.clean_status !== 'INVALID' : false;
        if (Boolean(r.included) !== nextVal) {
          r.included = nextVal;
          const editObj = STATE.excelCleanEdits[r.row_num] || { row_num: r.row_num };
          editObj.included = nextVal;
          STATE.excelCleanEdits[r.row_num] = editObj;
        }
      });
      renderExcelWorkflow();
    }

    function setVerifyToggle(rowNum, checked) {
      const prows = STATE.excelJob?.processed_rows || [];
      const pr = prows.find(x => Number(x.row_num) === Number(rowNum));
      if (pr) pr.include_in_export = Boolean(checked);
      STATE.excelVerifyToggles[String(rowNum)] = Boolean(checked);
      const cntEl = document.getElementById('verify-selected-count');
      if (cntEl) cntEl.textContent = String(prows.filter(x => x.include_in_export).length);
    }

    function bulkVerifySelect(mode) {
      const prows = STATE.excelJob?.processed_rows || [];
      prows.forEach(pr => {
        const nextVal = mode === 'ALL' ? true : (mode === 'CLEAN' ? !(pr.anomalies && pr.anomalies.length) : false);
        pr.include_in_export = nextVal;
        STATE.excelVerifyToggles[String(pr.row_num)] = nextVal;
      });
      renderExcelWorkflow();
    }

    async function uploadExcelFile() {
      const inp = document.getElementById('excel-file-input');
      const file = inp && inp.files ? inp.files[0] : null;
      if (!file) return;
      const fd = new FormData();
      fd.append('file', file);
      try {
        const res = await fetch('/api/excel/upload', { method: 'POST', body: fd });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || `HTTP ${res.status}`);
        resetExcelUiState();
        STATE.excelJob = data.job;
        renderExcelWorkflow();
        showToast(`Đã nạp ${file.name} -> ${excelNodeLabel(data.job.current_node)}`, 'success');
      } catch (err) {
        showToast('Lỗi nạp Excel: ' + err.message, 'error');
      } finally {
        inp.value = '';
      }
    }

