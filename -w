          <!-- Feedback -> Process loop -->
          <path d="M 695 198 C 580 202, 484 182, 434 142" fill="none" stroke="${edgeColor(['FEEDBACK'], '#EF4444')}" stroke-width="${edgeW(['FEEDBACK'])}" stroke-dasharray="4 3" marker-end="url(#${node === 'FEEDBACK' ? 'arr-ko' : 'arr-muted'})" />

          <!-- Xuất HTML -> Báo cáo & Dashboard -->
          <path d="M 822 58 Q 841 38 857 35" fill="none" stroke="${hasApproved ? '#10B981' : '#475569'}" stroke-width="${hasApproved ? '2.2' : '1.4'}" marker-end="url(#${hasApproved ? 'arr-ok' : 'arr-muted'})" />
          <path d="M 822 83 Q 841 106 857 115" fill="none" stroke="${hasApproved ? '#10B981' : '#475569'}" stroke-width="${hasApproved ? '2.2' : '1.4'}" marker-end="url(#${hasApproved ? 'arr-ok' : 'arr-muted'})" />

          <!-- NODES -->
          <g>
            <rect x="20" y="192" width="108" height="46" rx="10" ${nSheets.box} />
            <text x="74" y="219" text-anchor="middle" fill="${nSheets.text}" font-size="13" font-weight="700">Sheets</text>
          </g>
          <g>
            <rect x="185" y="110" width="116" height="46" rx="10" ${nClean.box} />
            <text x="243" y="137" text-anchor="middle" fill="${nClean.text}" font-size="13" font-weight="700">Cleaning</text>
          </g>
          <g>
            <rect x="368" y="205" width="92" height="46" rx="10" ${nErr.box} />
            <text x="414" y="232" text-anchor="middle" fill="${nErr.text}" font-size="13" font-weight="700">Lỗi</text>
          </g>
          <g>
            <rect x="368" y="92" width="116" height="46" rx="10" ${nProc.box} />
            <text x="426" y="119" text-anchor="middle" fill="${nProc.text}" font-size="13" font-weight="700">Process</text>
          </g>
          <g>
            <polygon points="578,36 638,86 578,136 518,86" ${nVer.box} />
            <text x="578" y="90" text-anchor="middle" fill="${nVer.text}" font-size="13" font-weight="700">Verify</text>
          </g>
          <g>
            <rect x="695" y="175" width="116" height="46" rx="10" ${nFb.box} />
            <text x="753" y="202" text-anchor="middle" fill="${nFb.text}" font-size="13" font-weight="700">Feedback</text>
          </g>
          <g>
            <rect x="700" y="48" width="122" height="46" rx="10" ${nExp.box} />
            <text x="761" y="75" text-anchor="middle" fill="${nExp.text}" font-size="13" font-weight="700">Xuất HTML</text>
          </g>
          <g ${reportClick}>
            <rect x="860" y="14" width="106" height="42" rx="10" ${nOut.box} />
            <text x="913" y="39" text-anchor="middle" fill="${nOut.text}" font-size="13" font-weight="700">Báo cáo</text>
          </g>
          <g ${dashClick}>
            <rect x="860" y="96" width="106" height="42" rx="10" ${nOut.box} />
            <text x="913" y="121" text-anchor="middle" fill="${nOut.text}" font-size="13" font-weight="700">Dashboard</text>
          </g>
        </svg>`;
    }

    function renderExcelWorkflow() {
      const sampleBox = document.getElementById('excel-sample-buttons');
      if (sampleBox) {
        sampleBox.innerHTML = (STATE.excelSampleFiles || []).map(sf => `
          <div class="inline-flex items-center rounded-lg liquid-pill overflow-hidden">
            <button onclick="loadSampleExcel('${escapeHtml(sf.filename)}')" class="px-3 py-1.5 text-xs font-semibold text-slate-700 hover:text-slate-900 hover:bg-slate-50 transition">
              Nạp ${escapeHtml(sf.label)}
            </button>
            <a href="/api/samples/${encodeURIComponent(sf.filename)}" title="Tải file mẫu" class="px-2 py-1.5 border-l border-slate-200 text-slate-500 hover:text-emerald-600 transition">
              <i data-lucide="download" class="w-3.5 h-3.5"></i>
            </a>
          </div>
        `).join('');
