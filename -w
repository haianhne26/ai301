      };

      const nSheets = styleNode('SHEETS', '#EFF6FF', '#93C5FD', '#DBEAFE', '#2563EB', '#1E3A8A');
      const nClean = styleNode('CLEANING', '#EFF6FF', '#93C5FD', '#DBEAFE', '#2563EB', '#1E3A8A');
      const nProc = styleNode('PROCESS', '#EFF6FF', '#93C5FD', '#DBEAFE', '#2563EB', '#1E3A8A');
      const nErr = styleNode('ERROR', '#FEF2F2', '#FCA5A5', '#FEE2E2', '#DC2626', '#991B1B');
      const nVer = styleNode('VERIFY', '#FEF3C7', '#FCD34D', '#FDE68A', '#D97706', '#78350F');
      const nFb = styleNode('FEEDBACK', '#FEF2F2', '#FCA5A5', '#FEE2E2', '#DC2626', '#991B1B');
