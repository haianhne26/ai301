          <path d="M 301 131 L 364 116" fill="none" stroke="${edgeColor(['CLEANING','VERIFY'], '#10B981')}" stroke-width="${edgeW(['CLEANING','VERIFY'])}" marker-end="url(#${['CLEANING','VERIFY'].includes(node) ? 'arr-ok' : 'arr-muted'})" />
          <rect x="319" y="113" width="30" height="17" rx="8" fill="#FFFFFF" stroke="#A7F3D0" />
