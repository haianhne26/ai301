      const riskF = document.getElementById('filter-risk')?.value || 'ALL';

      const chip = document.getElementById('active-filter-chip');
      if (chip) {
        const hasFilter = riskF !== 'ALL' || reg !== 'ALL' || tierF !== 'ALL';
        chip.classList.toggle('hidden', !hasFilter);
        chip.classList.toggle('flex', hasFilter);
