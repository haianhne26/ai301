    function renderCockpit() {
      const d = STATE.activeDossier;
      const maxUnlocked = d ? Math.max(2, d.current_step || 2) : 1;

      const titleEl = document.getElementById('cockpit-title');
      const subEl = document.getElementById('cockpit-subtitle');
      const idBadge = document.getElementById('cockpit-id-badge');
      const tierBadge = document.getElementById('cockpit-tier-badge');

      if (!d) {
        titleEl.textContent = 'Hồ sơ đối tác mới';
        subEl.textContent = 'Bước 1 · Nhập biểu mẫu hoặc tải tệp';
        idBadge.textContent = 'MỚI';
        tierBadge.classList.add('hidden');
      } else {
        const name = d.partner_profile?.legal?.company_name || 'Đối tác';
        titleEl.textContent = name;
        subEl.textContent = `${d.partner_profile?.location?.region || ''} · ${d.partner_profile?.location?.district || ''}, ${d.partner_profile?.location?.province || ''} · ${SHORT_STEP_STATUS[d.current_step] || ''}`;
        idBadge.textContent = d.dossier_id;
        const t = d.scoring_report?.tier || '';
        tierBadge.className = 'text-[11px] font-bold px-2.5 py-0.5 rounded-full border ' + (
          t === 'Tier A' ? 'bg-emerald-50 text-emerald-700 border-emerald-200'
          : t === 'Tier B' ? 'bg-blue-50 text-blue-700 border-blue-200'
          : t === 'Tier C' ? 'bg-amber-50 text-amber-700 border-amber-200'
          : 'bg-rose-50 text-rose-700 border-rose-200'
        );
        tierBadge.textContent = `${t} (${d.scoring_report?.final_score ?? 0}đ)`;
        tierBadge.classList.remove('hidden');
      }

      document.getElementById('cockpit-stepper').innerHTML = STEP_LABELS.map(item => {
        const isCurrent = STATE.cockpitStep === item.step;
        const isReached = d ? item.step <= 6 : item.step === 1;
        const isCompleted = d && item.step <= maxUnlocked;
        return `
          <button
            onclick="jumpCockpitStep(${item.step})"
            ${!isReached ? 'disabled' : ''}
            class="flex-1 px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center justify-center gap-1.5 transition ${
              isCurrent
                ? 'btn-glass-blue text-white'
                : isCompleted
                  ? 'bg-emerald-50 text-emerald-700 border border-emerald-200'
                  : isReached
                    ? 'text-slate-600 hover:text-slate-900 hover:bg-slate-200/70'
                    : 'text-slate-400 cursor-not-allowed'
            }"
          >
            <i data-lucide="${item.icon}" class="w-3.5 h-3.5"></i>
            <span>${item.step}. ${escapeHtml(item.short)}</span>
          </button>
        `;
      }).join('');

      const body = document.getElementById('cockpit-body');
      const dId = STATE.currentDossier?.dossier_id || null;
      const prevStep = STATE._lastCockpitStep;
      const sameDossier = STATE._lastCockpitDossierId === dId;
      body.classList.remove('apple-step-right', 'apple-step-left', 'apple-fade-up');
      void body.offsetWidth;
      if (prevStep != null && sameDossier && prevStep !== STATE.cockpitStep) {
        body.classList.add(STATE.cockpitStep > prevStep ? 'apple-step-right' : 'apple-step-left');
      } else {
        body.classList.add('apple-fade-up');
      }
      STATE._lastCockpitStep = STATE.cockpitStep;
      STATE._lastCockpitDossierId = dId;
      body.scrollTo({ top: 0, behavior: 'smooth' });
      requestAnimationFrame(() => requestAnimationFrame(animateCockpitGauges));
      if (STATE.cockpitStep === 1) body.innerHTML = renderStep1Html();
      else if (STATE.cockpitStep === 2) body.innerHTML = renderStep2Html(d);
      else if (STATE.cockpitStep === 3) body.innerHTML = renderStep3Html(d);
      else if (STATE.cockpitStep === 4) body.innerHTML = renderStep4Html(d);
      else if (STATE.cockpitStep === 5) body.innerHTML = renderStep5Html(d);
      else if (STATE.cockpitStep === 6) body.innerHTML = renderStep6Html(d);

      lucide.createIcons();
    }

    async function jumpCockpitStep(step) {
      if (!STATE.activeDossier && step > 1) return;
      if (STATE.activeDossier && step === 5 && !STATE.activeDossier.strategic_assessment) {
        STATE.cockpitStep = 5;
        renderCockpit();
        await runStep5Assessment(false);
        return;
      }
      if (STATE.activeDossier && step > (STATE.activeDossier.current_step || 2)) {
        try {
          const res = await apiFetch(`/api/dossiers/${STATE.activeDossier.dossier_id}/step`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ step }),
          });
          STATE.activeDossier = res.dossier;
          STATE.dossiers = res.dossiers;
          STATE.analytics = res.analytics;
          renderAll();
        } catch (err) {
          showToast(err.message, 'error');
          return;
        }
      }
      STATE.cockpitStep = step;
      renderCockpit();
    }

