          <!-- Lỗi -> Sheets loop -->
          <path d="M 368 238 Q 248 274 128 235" fill="none" stroke="${edgeColor(['ERROR'], '#EF4444')}" stroke-width="${edgeW(['ERROR'])}" stroke-dasharray="4 3" marker-end="url(#${node === 'ERROR' ? 'arr-ko' : 'arr-muted'})" />

