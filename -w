    let heroOrbMouse = { tx: 0, ty: 0, cx: 0, cy: 0, initialized: false, phase: 0, lastTs: 0 };
    let _orbCache = { dpr: 0, baseCanvas: null, cavityGrad: null, verts: null, strokes: null, els: null };

    function _ensureOrbAssets(dpr) {
      const cssW = 420, cx = 210, cy = 202, R = 148;
      if (_orbCache.dpr !== dpr || !_orbCache.baseCanvas) {
        const off = document.createElement('canvas');
        off.width = Math.round(cssW * dpr);
        off.height = Math.round(cssW * dpr);
        const octx = off.getContext('2d');
        octx.scale(dpr, dpr);

        // Floor shadow (baked once)
        const shGrad = octx.createRadialGradient(cx, cy + R + 10, 8, cx, cy + R + 10, 128);
        shGrad.addColorStop(0, 'rgba(6, 10, 26, 0.72)');
        shGrad.addColorStop(1, 'rgba(6, 10, 26, 0)');
        octx.save();
        octx.translate(cx, cy + R + 10);
        octx.scale(1, 0.24);
        octx.beginPath();
        octx.arc(0, 0, 128, 0, Math.PI * 2);
        octx.fillStyle = shGrad;
        octx.fill();
        octx.restore();

        // Outer 3D cobalt sphere (baked once)
        const sphereGrad = octx.createRadialGradient(cx - 56, cy - 58, 14, cx + 10, cy + 16, R * 1.15);
        sphereGrad.addColorStop(0, '#6BA8FF');
        sphereGrad.addColorStop(0.28, '#2C63EB');
        sphereGrad.addColorStop(0.72, '#16389E');
        sphereGrad.addColorStop(1, '#09153D');
        octx.beginPath();
        octx.arc(cx, cy, R, 0, Math.PI * 2);
        octx.fillStyle = sphereGrad;
        octx.fill();

        // Specular cobalt rim highlight (baked once)
        octx.beginPath();
        octx.arc(cx, cy, R - 1, -Math.PI * 0.92, -Math.PI * 0.22);
        octx.strokeStyle = 'rgba(191, 219, 254, 0.36)';
        octx.lineWidth = 2;
        octx.stroke();

        _orbCache.dpr = dpr;
        _orbCache.baseCanvas = off;
        _orbCache.cavityGrad = null;
      }

      if (!_orbCache.verts) {
        const lobes = 5;
        const apR = R * 0.76;
        const pts = [];
        for (let a = 0; a < Math.PI * 2; a += 0.085) {
          pts.push({
            cosA: Math.cos(a),
            sinA: Math.sin(a),
            cosLA: Math.cos(lobes * a),
            sinLA: Math.sin(lobes * a),
            apCos: Math.cos(a),
            apSin: Math.sin(a),
            apR
          });
        }
        _orbCache.verts = pts;

        const layers = 28;
        const strokes = [];
        for (let k = 0; k < layers; k++) {
          const alpha = 0.16 + (1 - k / layers) * 0.56;
          strokes.push(k % 2 === 0
            ? `rgba(219, 234, 254, ${alpha.toFixed(2)})`
            : `rgba(96, 165, 250, ${(alpha * 0.74).toFixed(2)})`);
        }
        _orbCache.strokes = strokes;
      }
    }

    function initHeroOrbCanvas() {
      const canvas = document.getElementById('hero-orb-canvas');
      if (!canvas) return;
      _orbCache.els = {
        sphere: document.getElementById('hero-accent-sphere'),
        bead: document.getElementById('hero-accent-bead'),
        cone: document.getElementById('hero-accent-cone')
      };
      if (!heroOrbMouse.initialized) {
        heroOrbMouse.initialized = true;
        window.addEventListener('mousemove', (e) => {
          if (!STATE.heroOrbActive) return;
          heroOrbMouse.tx = (e.clientX / window.innerWidth - 0.5) * 2;
          heroOrbMouse.ty = (e.clientY / window.innerHeight - 0.5) * 2;
        }, { passive: true });
      }
      requestAnimationFrame(drawHeroOrbFrame);
    }

    function drawHeroOrbFrame(ts) {
      const canvas = document.getElementById('hero-orb-canvas');
      if (!canvas || !STATE.heroOrbActive) {
        heroOrbMouse.lastTs = 0;
        return;
      }
      const now = ts || performance.now();
      const dt = heroOrbMouse.lastTs ? Math.min(0.05, (now - heroOrbMouse.lastTs) * 0.001) : 0.016;
      heroOrbMouse.lastTs = now;

      // Smooth damped lerp + slide pulse impulse
      heroOrbMouse.cx += (heroOrbMouse.tx - heroOrbMouse.cx) * 0.1;
      heroOrbMouse.cy += (heroOrbMouse.ty - heroOrbMouse.cy) * 0.1;
      heroOrbMouse.phase += dt * (0.55 + STATE.heroOrbPulse * 3.4);
      STATE.heroOrbPulse *= 0.91;
      if (STATE.heroOrbPulse < 0.002) STATE.heroOrbPulse = 0;

      // Update floating 3D parallax synced with rAF (zero layout reads)
      if (_orbCache.els) {
        const px = heroOrbMouse.cx, py = heroOrbMouse.cy;
        if (_orbCache.els.sphere) _orbCache.els.sphere.style.transform = `translate3d(${(-px * 9).toFixed(1)}px, ${(-py * 7).toFixed(1)}px, 0)`;
        if (_orbCache.els.bead) _orbCache.els.bead.style.transform = `translate3d(${(px * 12).toFixed(1)}px, ${(py * 9).toFixed(1)}px, 0)`;
        if (_orbCache.els.cone) _orbCache.els.cone.style.transform = `translate3d(${(-px * 7).toFixed(1)}px, ${(py * 10).toFixed(1)}px, 0)`;
      }

      const dpr = Math.min(1.5, window.devicePixelRatio || 1);
      const cssW = 420;
      const targetW = Math.round(cssW * dpr);
      if (canvas.width !== targetW) {
        canvas.width = targetW;
        canvas.height = targetW;
      }
      _ensureOrbAssets(dpr);

      const ctx = canvas.getContext('2d');
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.clearRect(0, 0, targetW, targetW);
      ctx.drawImage(_orbCache.baseCanvas, 0, 0);

      ctx.save();
      ctx.scale(dpr, dpr);

      const cx = 210, cy = 202, R = 148, apR = R * 0.76;
      const t = heroOrbMouse.phase;
      const apX = cx + 14 + heroOrbMouse.cx * 4.5;
      const apY = cy - 4 + heroOrbMouse.cy * 3.6;

      // Outer 5-lobe cavity mask using trig identities (zero loop trig!)
      const maskShift = -0.5 + t * 0.35;
      const cosMS = Math.cos(maskShift), sinMS = Math.sin(maskShift);
      const verts = _orbCache.verts;

      ctx.beginPath();
      for (let idx = 0; idx < verts.length; idx++) {
        const v = verts[idx];
        const mod = 1 + 0.065 * (v.cosLA * cosMS - v.sinLA * sinMS);
        const px = apX + v.cosA * apR * mod;
        const py = apY + v.sinA * apR * mod;
        if (idx === 0) ctx.moveTo(px, py);
        else ctx.lineTo(px, py);
      }
      ctx.closePath();

      if (!_orbCache.cavityGrad) {
        const cg = ctx.createRadialGradient(cx - 10, cy + 8, 10, cx + 14, cy - 4, apR * 1.1);
        cg.addColorStop(0, '#0F1A3F');
        cg.addColorStop(0.65, '#070E28');
        cg.addColorStop(1, '#030716');
        _orbCache.cavityGrad = cg;
      }
      ctx.fillStyle = _orbCache.cavityGrad;
      ctx.fill();
      ctx.clip();

      // 28 crisp hyperbolic tunnel rings using cached trig tables & cached stroke strings
      const strokes = _orbCache.strokes;
      const layers = strokes.length;
      ctx.lineWidth = 1.4;
      for (let k = 0; k < layers; k++) {
        const f = k / layers;
        const ringR = apR * (1.06 - f * 0.54);
        const rot = f * 1.25 + t * 0.4;
        const ox = apX - f * 14 + Math.cos(rot) * 6;
        const oy = apY + f * 8 + Math.sin(rot) * 5;
        const r5 = 5 * rot;
        const cos5R = Math.cos(r5), sin5R = Math.sin(r5);

        ctx.beginPath();
        for (let idx = 0; idx < verts.length; idx++) {
          const v = verts[idx];
          const wave = 1 + 0.095 * (v.cosLA * cos5R + v.sinLA * sin5R);
          const x = ox + v.cosA * ringR * wave;
          const y = oy + v.sinA * ringR * wave * 0.94;
          if (idx === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
        ctx.closePath();
        ctx.strokeStyle = strokes[k];
        ctx.stroke();
      }
      ctx.restore();

      requestAnimationFrame(drawHeroOrbFrame);
    }

    document.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        document.getElementById('top-global-search')?.focus();
      } else if (e.key === 'Escape') {
        const settingsModal = document.getElementById('settings-modal');
        const cockpitModal = document.getElementById('cockpit-modal');
        if (settingsModal && !settingsModal.classList.contains('hidden')) {
          closeSettingsModal();
        } else if (cockpitModal && !cockpitModal.classList.contains('hidden')) {
          closeCockpit();
        }
      }
    });

    async function handleBfcacheRestore() {
      try {
        const res = await apiFetch('/api/session/reset', { method: 'POST' });
        STATE.activeDossier = null;
        STATE.excelJob = null;
        STATE.dossiers = res.dossiers || [];
        STATE.analytics = res.analytics || {};
        renderAll();
      } catch (err) {
        loadBootstrap();
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      loadBootstrap();
      initHeroOrbCanvas();
    });

    window.addEventListener('pageshow', (e) => {
      if (e.persisted) handleBfcacheRestore();
    });
  </script>
</body>
