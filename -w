    function renderExcelFlowchartSvg(job) {
      const node = job ? job.current_node : '';
      const completed = node === 'COMPLETED';
      const hasApproved = completed || ((job?.approved_row_nums?.length || 0) > 0) || Boolean(job?.has_report);
