    function toggleSidebar(force) {
      const sb = document.getElementById('app-sidebar');
      const bd = document.getElementById('sidebar-backdrop');
      if (!sb) return;
      if (window.innerWidth >= 1024) {
        sb.classList.remove('lg:hidden');
        sb.classList.add('lg:flex');
        const hide = typeof force === 'boolean' ? !force : !sb.classList.contains('sidebar-collapsed-lg');
        sb.classList.toggle('sidebar-collapsed-lg', hide);
      } else {
        const open = typeof force === 'boolean' ? force : sb.classList.contains('-translate-x-full');
        sb.classList.toggle('-translate-x-full', !open);
        if (bd) {
          if (STATE._sidebarTimer) clearTimeout(STATE._sidebarTimer);
          if (open) {
            bd.classList.remove('hidden');
            requestAnimationFrame(() => bd.classList.remove('opacity-0'));
          } else {
            bd.classList.add('opacity-0');
            STATE._sidebarTimer = setTimeout(() => bd.classList.add('hidden'), 280);
          }
        }
      }
    }

