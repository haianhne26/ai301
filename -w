          <!-- Sheets -KO-> Lỗi -->
          <path d="M 128 214 L 363 224" fill="none" stroke="${edgeColor(['ERROR'], '#EF4444')}" stroke-width="${edgeW(['ERROR'])}" marker-end="url(#${node === 'ERROR' ? 'arr-ko' : 'arr-muted'})" />
          <rect x="232" y="210" width="30" height="17" rx="8" fill="#FFFFFF" stroke="#FECACA" />
          <text x="247" y="222" text-anchor="middle" fill="#B91C1C" font-size="10" font-weight="700">KO</text>

          <!-- Cleaning -KO-> Lỗi -->
          <path d="M 294 156 L 366 207" fill="none" stroke="${edgeColor(['CLEANING','ERROR'], '#EF4444')}" stroke-width="${edgeW(['CLEANING','ERROR'])}" marker-end="url(#${['CLEANING','ERROR'].includes(node) ? 'arr-ko' : 'arr-muted'})" />
          <rect x="315" y="172" width="30" height="17" rx="8" fill="#FFFFFF" stroke="#FECACA" />
