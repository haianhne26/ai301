    function _notifyExcelVerifyResult(job) {
      const va = job?.verify_alert || {};
      const okTotal = Number(job?.approved_count ?? (job?.approved_row_nums || []).length ?? 0);
      const koCount = Number(va.ko_count ?? (job?.ko_rows || []).length ?? 0);
      if (job.current_node === 'COMPLETED') {
        showToast(`Đã tự động phê duyệt ${okTotal} hồ sơ OK → Xuất HTML & đồng bộ Dashboard!`, 'success');
      } else if (job.current_node === 'FEEDBACK') {
        showToast(`Thông báo: Đã tự động duyệt ${okTotal} OK · Còn ${koCount} hồ sơ KO cần gửi Feedback!`, 'warning');
      }
    }

    async function submitCleaningDecision(outcome) {
      if (!STATE.excelJob || STATE.excelBusy) return;
      const rowUpdates = Object.values(STATE.excelCleanEdits || {});
      STATE.excelBusy = true;
      const btnOk = document.getElementById('btn-excel-clean-ok');
      if (btnOk) btnOk.textContent = 'Đang xử lý & tự động duyệt...';
      try {
        const data = await apiFetch(`/api/excel/jobs/${STATE.excelJob.job_id}/cleaning`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ outcome, row_updates: rowUpdates }),
        });
        _applyExcelResultState(data);
        if (outcome === 'KO') {
          showToast('Đã đánh dấu KO → chuyển node Lỗi', 'error');
        } else {
          _notifyExcelVerifyResult(data.job);
        }
      } catch (err) {
        showToast(err.message, 'error');
      } finally {
        STATE.excelBusy = false;
        renderAll();
      }
    }

