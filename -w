              <button onclick="loadSampleExcel('mau_nhap_excel_lam_sach_va_loi.xlsx')" class="px-4 py-2.5 rounded-lg liquid-pill text-xs font-semibold">
                Thử Mẫu Làm sạch &amp; Test Lỗi
              </button>
            </div>
          </div>`;
        lucide.createIcons();
        return;
      }

      if (badge) badge.textContent = `${job.job_id} · ${job.filename}`;
      const appCount = Number(job.approved_count ?? (job.approved_row_nums || []).length ?? 0);
      const koCount = Number((job.ko_rows || []).length || 0);
