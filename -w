<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Đại Thành DMS — Thẩm định Đối tác</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: { sans: ['Inter', '-apple-system', 'BlinkMacSystemFont', 'sans-serif'] },
          colors: {
            iosBlue: '#2563EB',
            iosPink: '#EF4444',
            iosRed: '#DC2626',
            iosGreen: '#10B981',
            iosAmber: '#F59E0B',
          }
        }
      }
    };
  </script>
  <style>
    :root {
      --lg-bg-base: #F4F6FA;
      --lg-surface: #FFFFFF;
      --lg-border: #E2E8F0;
    }

    body {
      background-color: var(--lg-bg-base);
      color: #1E293B;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
      position: relative;
      overflow-x: hidden;
    }

    /* Clean SaaS Enterprise Cards (AdmindeK Flat Style) */
    .liquid-panel {
      background: #FFFFFF;
      border: 1px solid #E2E8F0;
      box-shadow: 0 1px 3px rgba(15, 23, 42, 0.04), 0 1px 2px rgba(15, 23, 42, 0.03);
    }
    .modal-glass-panel {
      background: #FFFFFF;
      border: 1px solid #CBD5E1;
      box-shadow: 0 24px 60px -12px rgba(15, 23, 42, 0.25);
    }

    /* Secondary Outlined Button */
    .liquid-pill {
      background: #FFFFFF;
      border: 1px solid #CBD5E1;
      color: #334155;
      box-shadow: 0 1px 2px rgba(15, 23, 42, 0.04);
    }
    .liquid-pill:hover {
      background: #F8FAFC;
      border-color: #94A3B8;
      color: #0F172A;
    }

    /* Segmented Tabs (7d / 30d / 90d AdmindeK Style) */
    .liquid-segment-track {
      background: #FFFFFF;
      border: 1px solid #E2E8F0;
    }
    .liquid-segment-active {
      background: #2563EB;
      border: 1px solid #2563EB;
      color: #FFFFFF !important;
      box-shadow: 0 1px 2px rgba(37, 99, 235, 0.25);
    }

    /* Solid Action Buttons */
    .btn-glass-blue {
      background: #2563EB;
      border: 1px solid #2563EB;
      color: #FFFFFF;
      box-shadow: 0 1px 2px rgba(37, 99, 235, 0.22);
    }
    .btn-glass-blue:hover { background: #1D4ED8; border-color: #1D4ED8; }

    .btn-glass-crimson {
      background: #EF4444;
      border: 1px solid #EF4444;
      color: #FFFFFF;
      box-shadow: 0 1px 2px rgba(239, 68, 68, 0.22);
    }
    .btn-glass-crimson:hover { background: #DC2626; border-color: #DC2626; }

    .btn-glass-green {
      background: #10B981;
      border: 1px solid #10B981;
      color: #FFFFFF;
      box-shadow: 0 1px 2px rgba(16, 185, 129, 0.22);
    }
    .btn-glass-green:hover { background: #059669; border-color: #059669; }

    .btn-glass-amber {
      background: #F59E0B;
      border: 1px solid #F59E0B;
      color: #FFFFFF;
      box-shadow: 0 1px 2px rgba(245, 158, 11, 0.22);
    }
    .btn-glass-amber:hover { background: #D97706; border-color: #D97706; }

    /* Clean Light Form Inputs */
    .glass-input {
      background: #FFFFFF;
      border: 1px solid #CBD5E1;
      color: #0F172A;
      transition: border-color 0.18s, box-shadow 0.18s;
    }
    .glass-input::placeholder { color: #94A3B8; }
    .glass-input:focus {
      outline: none;
      border-color: #2563EB;
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
    }

    /* Clean Flat Toggle Switch */
    .toggle-switch {
      appearance: none;
      width: 44px;
      height: 24px;
      background: #CBD5E1;
      border: 1px solid #94A3B8;
      border-radius: 999px;
      position: relative;
      cursor: pointer;
      transition: all 0.2s cubic-bezier(0.22, 1, 0.36, 1);
      flex-shrink: 0;
    }
    .toggle-switch::after {
      content: '';
      position: absolute;
      top: 2px;
      left: 2px;
      width: 18px;
      height: 18px;
      background: #FFFFFF;
      border-radius: 999px;
      box-shadow: 0 1px 3px rgba(15, 23, 42, 0.25);
      transition: transform 0.22s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .toggle-switch:checked {
      background: #10B981;
      border-color: #10B981;
    }
    .toggle-switch:checked::after { transform: translateX(20px); }

    /* Crisp Spectrum Score Gauge */
    .spectrum-track {
      background: linear-gradient(90deg, #EF4444 0%, #F59E0B 45%, #3B82F6 75%, #10B981 100%);
      position: relative;
    }
    .spectrum-glass-thumb {
      width: 14px;
      height: 14px;
      border-radius: 999px;
      background: #FFFFFF;
      border: 2px solid #0F172A;
      box-shadow: 0 1px 3px rgba(15, 23, 42, 0.35);
      position: absolute;
      top: 50%;
      transform: translate(-50%, -50%);
    }

    .tabular-nums { font-variant-numeric: tabular-nums; }
    .liquid-sidebar {
      background: #1E293B;
      border-right: 1px solid #162032;
      color: #CBD5E1;
    }
    .liquid-topbar {
      background: #FFFFFF;
      border-bottom: 1px solid #E2E8F0;
    }
    .sidebar-nav-item {
      border-left: 3px solid transparent;
      transition: all 0.16s ease;
    }
    .sidebar-nav-item.active {
      border-left-color: #3B82F6;
      background: rgba(59, 130, 246, 0.15);
      color: #FFFFFF;
      font-weight: 600;
    }
    .custom-scroll::-webkit-scrollbar { width: 7px; height: 7px; }
    .custom-scroll::-webkit-scrollbar-track { background: transparent; }
    .custom-scroll::-webkit-scrollbar-thumb { background: rgba(100, 116, 139, 0.28); border-radius: 999px; }
    .custom-scroll::-webkit-scrollbar-thumb:hover { background: rgba(100, 116, 139, 0.45); }

    .markdown-body h3 { font-size: 0.95rem; font-weight: 700; color: #0F172A; margin-top: 0.95rem; margin-bottom: 0.35rem; }
    .markdown-body h3:first-child { margin-top: 0; }
    .markdown-body p { margin-bottom: 0.45rem; color: #334155; line-height: 1.55; }
    .markdown-body ul { list-style: disc; padding-left: 1.25rem; margin-bottom: 0.55rem; }
    .markdown-body li { margin-bottom: 0.3rem; color: #475569; line-height: 1.5; }
    .markdown-body strong { color: #0F172A; font-weight: 600; }

    /* Clean Periwinkle 3D Hero Stage (Matching Landing Reference) */
    .landing-stage {
      background: linear-gradient(160deg, #8B86DB 0%, #7F79D2 52%, #716BC7 100%);
    }
    .landing-horizon {
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.22) 0%, rgba(214, 214, 248, 0.38) 100%);
      border-top: 1px solid rgba(255, 255, 255, 0.32);
    }
    .landing-outline-num {
      -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.24);
      color: transparent;
      user-select: none;
    }

    /* ================= MOTION DESIGN SYSTEM (GPU 60FPS) ================= */
    :root {
      --apple-spring: cubic-bezier(0.22, 1, 0.36, 1);
      --apple-snappy: cubic-bezier(0.32, 0.72, 0, 1);
      --apple-bounce: cubic-bezier(0.34, 1.35, 0.64, 1);
    }

    button, a[href], select, .liquid-pill {
      transition: transform 0.18s var(--apple-snappy),
                  background-color 0.18s ease,
                  border-color 0.18s ease,
                  color 0.16s ease,
                  opacity 0.18s ease;
    }
    button:not(:disabled):active, a[href]:active {
      transform: scale(0.97);
    }
    .btn-glass-blue:hover, .btn-glass-green:hover, .btn-glass-amber:hover, .btn-glass-crimson:hover {
      transform: translate3d(0, -1px, 0);
    }

    .liquid-panel {
      transition: transform 0.26s var(--apple-spring), border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .apple-card-hover:hover {
      transform: translate3d(0, -2px, 0);
      border-color: #CBD5E1;
      box-shadow: 0 6px 18px -6px rgba(15, 23, 42, 0.08);
    }

    .toggle-switch::after {
      transition: transform 0.28s var(--apple-bounce);
    }
    .spectrum-glass-thumb {
      transition: left 0.6s var(--apple-spring), transform 0.2s var(--apple-bounce);
    }
    .spectrum-glass-thumb:hover {
      transform: translate(-50%, -50%) scale(1.18);
    }

    /* Sidebar desktop collapse via GPU margin-left + translate (zero internal text reflow!) */
    #app-sidebar {
      will-change: transform, margin-left, opacity;
      transition: margin-left 0.32s var(--apple-snappy),
                  transform 0.32s var(--apple-snappy),
                  opacity 0.22s ease;
    }
    @media (min-width: 1024px) {
      #app-sidebar.sidebar-collapsed-lg {
        margin-left: -240px;
        transform: translate3d(-14px, 0, 0);
        opacity: 0;
        pointer-events: none;
      }
    }
    #sidebar-backdrop {
      transition: opacity 0.24s ease;
    }
    .sidebar-nav-item {
      transition: transform 0.22s var(--apple-snappy), background-color 0.2s ease, color 0.18s ease, border-color 0.2s ease;
    }
    .sidebar-nav-item:hover {
      transform: translate3d(2px, 0, 0);
    }
    .sidebar-nav-item.active {
      transform: translate3d(3px, 0, 0);
    }

    #hero-enter-btn .hero-arrow-icon {
      transition: transform 0.28s var(--apple-spring);
    }
    #hero-enter-btn:hover .hero-arrow-icon {
      transform: translate3d(4px, 0, 0);
    }

    /* Pure transform + opacity transitions (zero expensive CSS filter blur!) */
    #landing-screen, #app-shell {
      transition: opacity 0.18s var(--apple-snappy), transform 0.24s var(--apple-snappy);
    }
    .apple-screen-exiting {
      opacity: 0 !important;
      transform: scale(1.018) translateZ(0) !important;
      pointer-events: none !important;
    }
    .apple-screen-entering {
      animation: appleScreenIn 0.36s var(--apple-spring) backwards;
    }

    @keyframes appleScreenIn {
      from { opacity: 0; transform: scale(0.988) translate3d(0, 6px, 0); }
      to   { opacity: 1; transform: scale(1) translate3d(0, 0, 0); }
    }
    @keyframes appleFadeUp {
      from { opacity: 0; transform: translate3d(0, 12px, 0); }
      to   { opacity: 1; transform: translate3d(0, 0, 0); }
    }
    @keyframes appleFloatSlow {
      0%, 100% { transform: translate3d(0, 0, 0); }
      50%      { transform: translate3d(0, -9px, 0); }
    }
    @keyframes appleFloatMed {
      0%, 100% { transform: translate3d(0, 0, 0); }
      50%      { transform: translate3d(3px, -6px, 0); }
    }
    @keyframes appleFloatCone {
      0%, 100% { transform: translate3d(0, 0, 0) rotate(0deg); }
      50%      { transform: translate3d(-3px, -8px, 0) rotate(-5deg); }
    }
    @keyframes appleHeroSlideIn {
      from { opacity: 0; transform: translate3d(0, 10px, 0); }
      to   { opacity: 1; transform: translate3d(0, 0, 0); }
    }
    @keyframes appleModalBackdropIn {
      from { opacity: 0; }
      to   { opacity: 1; }
    }
    @keyframes appleModalBackdropOut {
      from { opacity: 1; }
      to   { opacity: 0; }
    }
    @keyframes appleModalPanelIn {
      from { opacity: 0; transform: scale(0.955) translate3d(0, 12px, 0); }
      to   { opacity: 1; transform: scale(1) translate3d(0, 0, 0); }
    }
    @keyframes appleModalPanelOut {
      from { opacity: 1; transform: scale(1) translate3d(0, 0, 0); }
      to   { opacity: 0; transform: scale(0.965) translate3d(0, 8px, 0); }
    }
    @keyframes appleStepFromRight {
      from { opacity: 0; transform: translate3d(18px, 0, 0); }
      to   { opacity: 1; transform: translate3d(0, 0, 0); }
    }
    @keyframes appleStepFromLeft {
      from { opacity: 0; transform: translate3d(-18px, 0, 0); }
      to   { opacity: 1; transform: translate3d(0, 0, 0); }
    }
    @keyframes appleRowIn {
      from { opacity: 0; transform: translate3d(0, 6px, 0); }
      to   { opacity: 1; transform: translate3d(0, 0, 0); }
    }
    @keyframes appleToastIn {
      from { opacity: 0; transform: translate3d(20px, 0, 0) scale(0.96); }
      to   { opacity: 1; transform: translate3d(0, 0, 0) scale(1); }
    }
    @keyframes appleToastOut {
      from { opacity: 1; transform: translate3d(0, 0, 0) scale(1); }
      to   { opacity: 0; transform: translate3d(20px, 0, 0) scale(0.96); }
    }
    @keyframes appleSparkDraw {
      from { stroke-dashoffset: 100; }
      to   { stroke-dashoffset: 0; }
    }
    @keyframes appleSparkAreaFade {
      from { opacity: 0; }
      to   { opacity: 1; }
    }
    @keyframes appleSpinOnce {
      from { transform: rotate(0deg); }
      to   { transform: rotate(-360deg); }
    }
    @keyframes appleNumPop {
      0%   { opacity: 0.5; transform: translate3d(0, 3px, 0); }
      100% { opacity: 1; transform: translate3d(0, 0, 0); }
    }

    .apple-float-slow { animation: appleFloatSlow 6.8s ease-in-out infinite; will-change: transform; }
    .apple-float-med  { animation: appleFloatMed 5.4s ease-in-out infinite 0.5s; will-change: transform; }
    .apple-float-cone { animation: appleFloatCone 7.6s ease-in-out infinite 1s; will-change: transform; }
    .apple-fade-up    { animation: appleFadeUp 0.36s var(--apple-spring) backwards; }
    .apple-stagger-1  { animation: appleFadeUp 0.38s var(--apple-spring) 0.03s backwards; }
    .apple-stagger-2  { animation: appleFadeUp 0.38s var(--apple-spring) 0.08s backwards; }
    .apple-stagger-3  { animation: appleFadeUp 0.38s var(--apple-spring) 0.13s backwards; }

    .apple-hero-swap-in  { animation: appleHeroSlideIn 0.32s var(--apple-spring) backwards; }

    .apple-modal-opening { animation: appleModalBackdropIn 0.2s ease-out backwards; }
    .apple-modal-opening .apple-modal-panel { animation: appleModalPanelIn 0.28s var(--apple-spring) backwards; will-change: transform, opacity; }
    .apple-modal-closing { animation: appleModalBackdropOut 0.16s ease-in forwards; pointer-events: none; }
    .apple-modal-closing .apple-modal-panel { animation: appleModalPanelOut 0.16s ease-in forwards; }

    .apple-step-right { animation: appleStepFromRight 0.26s var(--apple-spring) backwards; }
    .apple-step-left  { animation: appleStepFromLeft 0.26s var(--apple-spring) backwards; }
    .apple-row-in     { animation: appleRowIn 0.28s var(--apple-spring) backwards; }
    .apple-toast-in   { animation: appleToastIn 0.32s var(--apple-spring) backwards; }
    .apple-toast-out  { animation: appleToastOut 0.2s ease-in forwards; }
    .apple-spark-line { stroke-dasharray: 100; stroke-dashoffset: 100; animation: appleSparkDraw 0.65s var(--apple-spring) 0.05s forwards; }
    .apple-spark-area { animation: appleSparkAreaFade 0.5s ease-out 0.1s backwards; }
    .apple-spin-once  { animation: appleSpinOnce 0.48s var(--apple-spring); }
    .apple-num-pop    { animation: appleNumPop 0.26s var(--apple-spring) backwards; }
    @keyframes appleDonutReveal {
      from { opacity: 0; transform: scale(0.88) rotate(-18deg); }
      to   { opacity: 1; transform: scale(1) rotate(0deg); }
    }
    .apple-bar-fill   { transition: width 0.65s var(--apple-spring); }
    .apple-donut-reveal { animation: appleDonutReveal 0.5s var(--apple-spring) backwards; transform-origin: center center; }
    .apple-donut-slice { transition: opacity 0.2s ease; }
    .apple-donut-slice:hover { opacity: 0.85; }

    #dossier-table-body > tr {
      transition: background-color 0.18s ease;
      animation: appleRowIn 0.26s var(--apple-spring) backwards;
    }
    #dossier-table-body > tr:nth-child(1) { animation-delay: 0.01s; }
    #dossier-table-body > tr:nth-child(2) { animation-delay: 0.03s; }
    #dossier-table-body > tr:nth-child(3) { animation-delay: 0.05s; }
    #dossier-table-body > tr:nth-child(4) { animation-delay: 0.07s; }
    #dossier-table-body > tr:nth-child(5) { animation-delay: 0.09s; }
    #dossier-table-body > tr:nth-child(n+6) { animation-delay: 0.11s; }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }
  </style>
</head>
<body class="min-h-screen antialiased selection:bg-blue-600/20 selection:text-slate-900">

  <!-- LANDING PAGE ENTRY EXPERIENCE (Clean 3D Studio Hero Matching Reference) -->
  <section id="landing-screen" class="landing-stage min-h-screen relative overflow-hidden flex flex-col justify-between text-white">
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-[19vh] landing-horizon z-0"></div>
    <div class="pointer-events-none absolute right-6 sm:right-12 bottom-[13vh] z-0 font-black text-[96px] sm:text-[138px] leading-none tracking-tighter landing-outline-num">06</div>

    <header class="relative z-10 max-w-[1320px] w-full mx-auto px-6 sm:px-10 pt-6 sm:pt-8 flex items-center justify-between gap-4 apple-stagger-1">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-lg border border-white/50 bg-white/10 flex items-center justify-center text-xs font-extrabold text-white tracking-tight">ĐT</div>
        <span class="text-sm font-bold tracking-tight text-white">Đại Thành</span>
      </div>

      <nav class="hidden md:flex items-center gap-2 text-xs font-medium">
        <button onclick="selectHeroSlide(0)" id="hnav-0" class="px-4 py-1.5 rounded-full border border-white/60 bg-white/15 text-white transition">Quy trình</button>
        <button onclick="selectHeroSlide(1)" id="hnav-1" class="px-4 py-1.5 rounded-full border border-transparent text-white/80 hover:text-white transition">Địa bàn GPS</button>
        <button onclick="selectHeroSlide(2)" id="hnav-2" class="px-4 py-1.5 rounded-full border border-transparent text-white/80 hover:text-white transition">Bẫy cam kết</button>
        <button onclick="selectHeroSlide(3)" id="hnav-3" class="px-4 py-1.5 rounded-full border border-transparent text-white/80 hover:text-white transition">Chính sách</button>
      </nav>

      <button onclick="enterApp('dashboard')" class="px-4 py-1.5 rounded-full border border-white/55 bg-white/10 hover:bg-white hover:text-indigo-700 text-xs font-semibold text-white flex items-center gap-2 transition">
        <span class="hidden sm:inline">Hệ thống</span>
        <i data-lucide="menu" class="w-4 h-4"></i>
      </button>
    </header>

    <div class="relative z-10 max-w-[1320px] w-full mx-auto px-6 sm:px-10 grid grid-cols-1 lg:grid-cols-12 items-center gap-6 lg:gap-4 flex-1 py-4">
      <div class="lg:col-span-4 space-y-5 text-center lg:text-left apple-stagger-1">
        <div id="hero-copy-left" class="space-y-5">
          <div>
            <p id="hero-kicker" class="text-xs sm:text-sm font-medium text-white/90 tracking-wide">3 khu vực · 30 hồ sơ / tháng</p>
            <div class="w-5 h-px bg-white/60 mt-3 mx-auto lg:mx-0"></div>
          </div>

          <h1 class="text-4xl sm:text-5xl xl:text-[52px] leading-[1.08] tracking-tight">
            <span id="hero-title-light" class="block font-light text-white/90">Thẩm định</span>
            <span id="hero-title-bold" class="block font-extrabold text-white mt-1">Đối tác<br/>6 Bước</span>
          </h1>
        </div>

        <div class="flex items-center justify-center lg:justify-start gap-2.5 pt-1">
          <button onclick="selectHeroSlide(0)" id="hdot-0" class="w-2.5 h-2.5 rounded-full bg-white transition-all duration-300"></button>
          <button onclick="selectHeroSlide(1)" id="hdot-1" class="w-2 h-2 rounded-full bg-white/40 hover:bg-white/80 transition-all duration-300"></button>
          <button onclick="selectHeroSlide(2)" id="hdot-2" class="w-2 h-2 rounded-full bg-white/40 hover:bg-white/80 transition-all duration-300"></button>
          <button onclick="selectHeroSlide(3)" id="hdot-3" class="w-2 h-2 rounded-full bg-white/40 hover:bg-white/80 transition-all duration-300"></button>
        </div>
      </div>

      <div class="lg:col-span-4 relative flex items-center justify-center min-h-[300px] sm:min-h-[390px] apple-stagger-2">
        <div id="hero-accent-sphere" class="pointer-events-none absolute top-4 right-8 sm:right-10 will-change-transform">
          <div class="w-12 h-12 rounded-full border border-white/45 bg-gradient-to-br from-white via-indigo-200 to-indigo-400 shadow-[0_14px_28px_rgba(45,42,110,0.3)] apple-float-slow"></div>
        </div>
        <div id="hero-accent-bead" class="pointer-events-none absolute bottom-12 left-8 sm:left-10 will-change-transform">
          <div class="w-4 h-4 rounded-full bg-blue-500 border border-white/40 apple-float-med"></div>
        </div>
        <div id="hero-accent-cone" class="pointer-events-none absolute bottom-8 right-6 sm:right-8 will-change-transform">
          <svg class="w-11 h-11 drop-shadow-[0_10px_16px_rgba(30,40,100,0.35)] apple-float-cone" viewBox="0 0 48 48" fill="none">
            <defs>
              <linearGradient id="coneGradA" x1="10" y1="6" x2="38" y2="42" gradientUnits="userSpaceOnUse">
                <stop offset="0%" stop-color="#FFFFFF" />
                <stop offset="100%" stop-color="#60A5FA" />
              </linearGradient>
            </defs>
            <polygon points="34,6 10,34 40,40" fill="url(#coneGradA)" stroke="rgba(255,255,255,0.65)" stroke-width="1" />
          </svg>
        </div>

        <canvas id="hero-orb-canvas" width="420" height="420" class="w-[290px] h-[290px] sm:w-[370px] sm:h-[370px] relative z-10 cursor-pointer hover:scale-[1.015] active:scale-[0.98] transition-transform duration-300" onclick="selectHeroSlide((STATE.heroSlide + 1) % 4)" title="Nhấn để chuyển mục"></canvas>
