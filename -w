  <script>
    const STATE = {
      llmStatus: {},
      policies: {},
      _lastCockpitStep: null,
      _lastCockpitDossierId: null,
      _heroSlideTimer: null,
      _screenTimer: null,
      _modalTimers: {},
      _sidebarTimer: null,
      heroOrbPulse: 0,
      heroMouseX: 0,
      heroMouseY: 0,
      existingPartners: [],
      presets: {},
      sampleFiles: [],
      excelSampleFiles: [],
      excelJob: null,
      excelBusy: false,
      excelCleanPage: 1,
      excelVerifyPage: 1,
      excelKoPage: 1,
      excelCleanEdits: {},
      excelVerifyToggles: {},
      excelKoExcluded: {},
      dossierPage: 1,
      dossiers: [],
      analytics: {},
      activeDossier: null,
      cockpitStep: 1,
      intakeMode: 'form',
      draftProfile: null,
      rawExtractedText: '',
      intakeSourceInfo: 'Biểu mẫu trực tuyến',
      card1Mode: 'ALL',
      heroSlide: 0,
      heroOrbActive: true,
    };

    const STEP_LABELS = [
      { step: 1, short: 'Tiếp nhận', icon: 'file-plus' },
      { step: 2, short: 'Đối chiếu', icon: 'shield-alert' },
      { step: 3, short: 'Xác minh', icon: 'clipboard-check' },
      { step: 4, short: 'Chấm điểm', icon: 'gauge' },
      { step: 5, short: 'Phê duyệt', icon: 'user-check' },
      { step: 6, short: 'Bàn giao', icon: 'send' },
    ];

    const SHORT_STEP_STATUS = {
      1: 'B1 · Tiếp nhận',
      2: 'B2 · Đã đối chiếu',
      3: 'B3 · Đang xác minh',
      4: 'B4 · Đã chấm điểm',
      5: 'B5 · Chờ phê duyệt',
      6: 'B6 · Hoàn tất',
    };

    function escapeHtml(str) {
      if (str === null || str === undefined) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function showToast(message, type = 'info') {
      const container = document.getElementById('toast-container');
      const accent = {
        success: 'border-emerald-300 text-emerald-700 bg-emerald-50',
        error: 'border-rose-300 text-rose-700 bg-rose-50',
        warning: 'border-amber-300 text-amber-800 bg-amber-50',
        info: 'border-blue-300 text-slate-800 bg-white',
      };
      const el = document.createElement('div');
      el.className = `px-4 py-3 rounded-xl border shadow-lg text-xs font-medium apple-toast-in ${accent[type] || accent.info}`;
      el.textContent = message;
      container.appendChild(el);
      setTimeout(() => {
        el.classList.remove('apple-toast-in');
        el.classList.add('apple-toast-out');
        setTimeout(() => el.remove(), 260);
      }, 3800);
    }

    function tierBadgeHtml(tier) {
      const map = {
        'Tier A': 'bg-emerald-50 text-emerald-700 border-emerald-200',
        'Tier B': 'bg-blue-50 text-blue-700 border-blue-200',
        'Tier C': 'bg-amber-50 text-amber-700 border-amber-200',
        'Tier D': 'bg-rose-50 text-rose-700 border-rose-200',
      };
      const cls = map[tier] || 'bg-slate-100 text-slate-700 border-slate-200';
      return `<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10.5px] font-bold border whitespace-nowrap shrink-0 ${cls}">${escapeHtml(tier || 'N/A')}</span>`;
    }

    function renderMarkdownSafe(mdText) {
      if (!mdText) return '<p class="text-slate-400">Chưa có dữ liệu phân tích.</p>';
      const lines = mdText.split('\n');
      let html = '';
      let inList = false;
      for (const rawLine of lines) {
        const line = rawLine.trim();
        if (!line) {
          if (inList) { html += '</ul>'; inList = false; }
          continue;
        }
        const escaped = escapeHtml(line).replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
        if (line.startsWith('### ') || line.startsWith('## ')) {
          if (inList) { html += '</ul>'; inList = false; }
          html += `<h3>${escaped.replace(/^#{2,3}\s*/, '')}</h3>`;
        } else if (line.startsWith('- ') || line.startsWith('* ')) {
          if (!inList) { html += '<ul>'; inList = true; }
          html += `<li>${escaped.slice(2)}</li>`;
        } else {
          if (inList) { html += '</ul>'; inList = false; }
          html += `<p>${escaped}</p>`;
        }
      }
      if (inList) html += '</ul>';
      return `<div class="markdown-body text-xs sm:text-[13px]">${html}</div>`;
    }

    async function apiFetch(url, options = {}) {
      const res = await fetch(url, options);
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || `HTTP ${res.status}`);
      return data;
    }

    async function loadBootstrap() {
      try {
        const data = await apiFetch('/api/bootstrap');
        STATE.llmStatus = data.llm_status || {};
        STATE.policies = data.policies || {};
        STATE.existingPartners = data.existing_partners || [];
        STATE.presets = data.presets || {};
        STATE.sampleFiles = data.sample_files || [];
        STATE.excelSampleFiles = data.excel_sample_files || [];
        STATE.excelJob = data.latest_excel_job || null;
        STATE.dossiers = data.dossiers || [];
        STATE.analytics = data.analytics || {};
        renderAll();
      } catch (err) {
        showToast('Lỗi tải dữ liệu khởi tạo: ' + err.message, 'error');
      }
    }

    function renderAll() {
      renderLlmStatus();
      renderKPIs();
      renderCharts();
      renderDossierTable();
      renderExistingPartners();
      renderPoliciesTab();
      renderExcelWorkflow();
      lucide.createIcons();
    }

    function renderLlmStatus() {
      const dot = document.getElementById('llm-dot');
      const lbl = document.getElementById('llm-label');
      const modelInput = document.getElementById('settings-model');
      if (STATE.llmStatus.primary_model && modelInput) {
        modelInput.value = STATE.llmStatus.primary_model;
      }
      if (STATE.llmStatus.configured) {
        dot.className = 'w-2 h-2 rounded-full bg-iosGreen shadow-[0_0_8px_#30D158]';
        lbl.textContent = `${STATE.llmStatus.primary_model}`;
      } else {
        dot.className = 'w-2 h-2 rounded-full bg-iosAmber';
        lbl.textContent = `API Key`;
      }
    }

    function setCard1Mode(mode) {
      STATE.card1Mode = mode;
      ['ALL', 'AB', 'RISK'].forEach(m => {
        const b = document.getElementById(`c1-btn-${m}`);
        if (!b) return;
        b.className = m === mode
          ? 'px-2.5 py-1 rounded-md transition liquid-segment-active text-white whitespace-nowrap'
          : 'px-2.5 py-1 rounded-md transition text-slate-500 hover:text-slate-900 whitespace-nowrap';
      });
      renderKPIs();
    }

    function isDossierRisky(d) {
      const comp = d.compliance_report || {};
      const sc = d.scoring_report || {};
      return Boolean(comp.has_bad_debt_match || comp.has_geofence_conflict || comp.has_policy_breach || sc.phantom_commitment_alert);
    }

    function renderKPIs() {
      const a = STATE.analytics || {};
      const mode = STATE.card1Mode || 'ALL';
      const subset = STATE.dossiers.filter(d => {
        const t = d.scoring_report?.tier || '';
        if (mode === 'AB') return t === 'Tier A' || t === 'Tier B';
        if (mode === 'RISK') return isDossierRisky(d);
        return true;
      });
      const sumCommit = subset.reduce((acc, d) => acc + Number(d.partner_profile?.commercial?.monthly_commitment_billion_vnd || 0), 0);
      const valEl = document.getElementById('card1-value');
      const subEl = document.getElementById('card1-sub');
      const sparkEl = document.getElementById('card1-sparkline');
      if (valEl) valEl.textContent = `${sumCommit.toFixed(2)} tỷ`;
      if (subEl) {
        const suffix = mode === 'AB' ? 'đối tác A/B' : (mode === 'RISK' ? 'hồ sơ cảnh báo' : `/ ${a.monthly_target || 30} chỉ tiêu tháng`);
        subEl.textContent = `${subset.length} ${suffix}`;
      }

      // Smooth Blue Glass Wave Sparkline across subset values
      if (sparkEl) {
        const vals = subset.map(d => Number(d.partner_profile?.commercial?.monthly_commitment_billion_vnd || 0));
        const ptsRaw = vals.length >= 2 ? vals : (vals.length === 1 ? [0, vals[0], vals[0] * 0.85] : [0, 0, 0]);
        const maxV = Math.max(1, ...ptsRaw);
        const W = 280, H = 64, padY = 8;
        const coords = ptsRaw.map((v, idx) => {
          const x = (idx / Math.max(1, ptsRaw.length - 1)) * W;
          const y = H - padY - (v / maxV) * (H - padY * 2);
          return [x, y];
        });
        let dPath = `M ${coords[0][0].toFixed(1)} ${coords[0][1].toFixed(1)}`;
        for (let i = 1; i < coords.length; i++) {
          const prev = coords[i - 1], curr = coords[i];
          const cx = ((prev[0] + curr[0]) / 2).toFixed(1);
          dPath += ` C ${cx} ${prev[1].toFixed(1)}, ${cx} ${curr[1].toFixed(1)}, ${curr[0].toFixed(1)} ${curr[1].toFixed(1)}`;
        }
        const areaPath = `${dPath} L ${W} ${H} L 0 ${H} Z`;
        sparkEl.innerHTML = `
          <svg viewBox="0 0 ${W} ${H}" class="w-full h-full overflow-visible" preserveAspectRatio="none">
            <defs>
              <linearGradient id="sparkBlueGrad" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0%" stop-color="#2563EB" stop-opacity="0.16" />
                <stop offset="100%" stop-color="#2563EB" stop-opacity="0" />
              </linearGradient>
            </defs>
            <path d="${areaPath}" fill="url(#sparkBlueGrad)" class="apple-spark-area" />
            <path d="${dPath}" pathLength="100" fill="none" stroke="#2563EB" stroke-width="2.2" stroke-linecap="round" class="apple-spark-line" />
          </svg>
        `;
      }

      // Card 2: Average Score + Stars + Solid Emerald Pill
      const avgScore = Number(a.avg_final_score || 0);
      const initScore = Number(a.avg_initial_score || 0);
      const scoreEl = document.getElementById('card2-score');
      const abPill = document.getElementById('card2-ab-pill');
      const starsEl = document.getElementById('card2-stars');
      const badgeEl = document.getElementById('card2-badge');
      if (scoreEl) scoreEl.textContent = avgScore.toFixed(1);
      if (abPill) abPill.textContent = `A/B: ${a.tier_ab_rate_pct || 0}%`;
      if (starsEl) {
        const filled = Math.max(0, Math.min(5, Math.round(avgScore / 20)));
        starsEl.innerHTML = [1, 2, 3, 4, 5].map(i =>
          `<i data-lucide="star" class="w-4 h-4 ${i <= filled ? 'text-amber-400 fill-current' : 'text-slate-200'}"></i>`
        ).join('');
      }
      if (badgeEl) {
        const delta = +(avgScore - initScore).toFixed(1);
        const good = delta >= 0;
        badgeEl.className = `mt-3 inline-flex items-center gap-1 px-3 py-1 rounded-md text-xs font-semibold tabular-nums ${
          good ? 'bg-emerald-500 text-white' : 'bg-amber-500 text-white'
        }`;
        badgeEl.textContent = `${good ? '↑' : '↓'} Sơ bộ ${initScore}đ · ${a.tier_ab_count || 0} đạt A/B`;
      }

      // Update alert counters (Topbar Bell + Sidebar Risk Badge + Excel KO banner)
      const va = STATE.excelJob?.verify_alert || {};
      const excelKoCount = (va.active && Number(va.ko_count || 0) > 0) ? Number(va.ko_count || 0) : 0;
      const riskAlerts = a.red_alerts_caught || 0;
      const totalAlerts = riskAlerts + excelKoCount;
      const topBadge = document.getElementById('topbar-alert-badge');
      const sideBadge = document.getElementById('sidebar-risk-count');
      if (topBadge) {
        topBadge.textContent = totalAlerts;
        topBadge.className = `absolute -top-1 -right-1 min-w-[16px] h-4 px-1 rounded-full ${excelKoCount > 0 ? 'bg-amber-500' : 'bg-emerald-500'} text-[9px] font-bold text-white flex items-center justify-center ${totalAlerts <= 0 ? 'hidden' : ''}`;
      }
      if (sideBadge) sideBadge.textContent = riskAlerts;
      renderExcelKoBanner();

      if (valEl) {
        valEl.classList.remove('apple-num-pop');
        void valEl.offsetWidth;
        valEl.classList.add('apple-num-pop');
      }
      requestAnimationFrame(() => requestAnimationFrame(triggerVisualMetricsMotion));
    }

    function triggerRefreshSpin(btn) {
      const icon = btn?.querySelector('svg, i');
      if (!icon) return;
      icon.classList.remove('apple-spin-once');
      void icon.offsetWidth;
      icon.classList.add('apple-spin-once');
    }

    function openModalSpring(modalId) {
      const modal = document.getElementById(modalId);
      if (!modal) return;
      if (STATE._modalTimers[modalId]) {
        clearTimeout(STATE._modalTimers[modalId]);
        delete STATE._modalTimers[modalId];
      }
      if (modalId === 'cockpit-modal' && modal.classList.contains('hidden')) {
        STATE._lastCockpitStep = null;
        STATE._lastCockpitDossierId = null;
      }
      modal.classList.remove('hidden', 'apple-modal-closing');
      modal.classList.remove('apple-modal-opening');
      void modal.offsetWidth;
      modal.classList.add('apple-modal-opening');
    }

    function closeModalSpring(modalId) {
      const modal = document.getElementById(modalId);
      if (!modal || modal.classList.contains('hidden')) return;
      if (STATE._modalTimers[modalId]) clearTimeout(STATE._modalTimers[modalId]);
      modal.classList.remove('apple-modal-opening');
      modal.classList.add('apple-modal-closing');
      STATE._modalTimers[modalId] = setTimeout(() => {
        modal.classList.add('hidden');
        modal.classList.remove('apple-modal-closing');
        delete STATE._modalTimers[modalId];
      }, 160);
    }

