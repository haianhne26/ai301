        const totalPages = Math.max(1, Math.ceil(rows.length / PAGE_SIZE));
        STATE.excelCleanPage = Math.min(Math.max(1, STATE.excelCleanPage || 1), totalPages);
        const startIdx = (STATE.excelCleanPage - 1) * PAGE_SIZE;
