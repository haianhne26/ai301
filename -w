    function renderCharts() {
      const a = STATE.analytics || {};
      const total = a.total_dossiers || 0;
      const totalSafe = Math.max(1, total);

      const cBadge = document.getElementById('chart-total-badge');
      const c3Label = document.getElementById('card3-total-label');
      if (cBadge) cBadge.textContent = `${total} hồ sơ`;
      if (c3Label) c3Label.textContent = `${total} HS`;

      // Card 3: Horizontal Bar Statistics (AdmindeK Teal/Blue Bars on Light Track)
      const barRows = [
        { label: 'Miền Bắc', val: a.region_counts?.KV1 || 0, color: '#10B981' },
        { label: 'Miền Trung', val: a.region_counts?.KV2 || 0, color: '#2563EB' },
        { label: 'Miền Nam', val: a.region_counts?.KV3 || 0, color: '#14B8A6' },
        { label: 'Bẫy ảo', val: a.phantom_count || 0, color: '#EF4444' },
      ];
      const maxBar = Math.max(4, ...barRows.map(r => r.val));
      const tickStep = Math.max(1, Math.ceil(maxBar / 4));
      const axisMax = tickStep * 4;
      const ticks = [0, tickStep, tickStep * 2, tickStep * 3, axisMax];

      const regionBarsEl = document.getElementById('chart-region-bars');
      if (regionBarsEl) {
        regionBarsEl.innerHTML = `
          <div class="space-y-3">
            ${barRows.map((r, idx) => {
              const wPct = Math.round((r.val / axisMax) * 100);
              return `
                <div class="grid grid-cols-12 items-center gap-2 text-xs">
                  <span class="col-span-4 text-slate-600 font-medium truncate">${escapeHtml(r.label)}</span>
                  <div class="col-span-7 h-3 rounded-full bg-slate-100 overflow-hidden">
                    <div class="h-full rounded-full apple-bar-fill js-bar-fill" style="width:0%; background:${r.color}; transition-delay:${idx * 55}ms" data-target-width="${wPct}%"></div>
                  </div>
                  <span class="col-span-1 text-right font-bold text-slate-800 tabular-nums">${r.val}</span>
                </div>
              `;
            }).join('')}
          </div>
          <div class="grid grid-cols-12 mt-3 pt-2 border-t border-slate-100 text-[10px] text-slate-400 tabular-nums">
            <div class="col-span-4"></div>
            <div class="col-span-7 flex justify-between">
              ${ticks.map(t => `<span>${t}</span>`).join('')}
            </div>
            <div class="col-span-1"></div>
          </div>
        `;
      }

      // Row 2 Left: Donut Chart (Tier A, B, C, D matching AdmindeK Phone Calls Donut)
      const donutEl = document.getElementById('chart-tier-donut');
      const legendEl = document.getElementById('chart-tier-legend');
      const tierSegs = [
        { label: 'Tier A', count: a.tier_counts?.['Tier A'] || 0, color: '#10B981' },
        { label: 'Tier B', count: a.tier_counts?.['Tier B'] || 0, color: '#2563EB' },
        { label: 'Tier C', count: a.tier_counts?.['Tier C'] || 0, color: '#F59E0B' },
        { label: 'Tier D', count: a.tier_counts?.['Tier D'] || 0, color: '#EF4444' },
      ];
      if (donutEl) {
        const size = 210, cx = 105, cy = 105, r = 72, strokeW = 34;
        const circ = 2 * Math.PI * r;
        const nonZero = tierSegs.filter(s => s.count > 0);
        if (!nonZero.length) {
          donutEl.innerHTML = `
            <svg viewBox="0 0 ${size} ${size}" class="w-[210px] h-[210px]" role="img" aria-label="Chưa có dữ liệu">
              <circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="#E2E8F0" stroke-width="${strokeW}" />
              <text x="${cx}" y="${cy - 3}" text-anchor="middle" font-size="22" font-weight="800" fill="#94A3B8">0</text>
              <text x="${cx}" y="${cy + 14}" text-anchor="middle" font-size="10.5" fill="#94A3B8">Hồ sơ</text>
            </svg>
          `;
        } else {
          let cumPct = 0;
          const arcs = nonZero.map(s => {
            const pct = s.count / totalSafe;
            const gap = nonZero.length > 1 ? 3 : 0;
            const segLen = Math.max(0, pct * circ - gap);
            const dashOffset = -(cumPct * circ);
            const midAngle = (cumPct + pct / 2) * 2 * Math.PI - Math.PI / 2;
            const lx = cx + r * Math.cos(midAngle);
            const ly = cy + r * Math.sin(midAngle);
            const pctTxt = Math.round(pct * 100);
            cumPct += pct;
            return `
              <circle cx="${cx}" cy="${cy}" r="${r}" fill="none" stroke="${s.color}" stroke-width="${strokeW}"
                class="apple-donut-slice"
                stroke-dasharray="${segLen.toFixed(2)} ${(circ - segLen).toFixed(2)}"
                stroke-dashoffset="${dashOffset.toFixed(2)}"
                transform="rotate(-90 ${cx} ${cy})" />
              ${pctTxt >= 12 ? `<text x="${lx.toFixed(1)}" y="${(ly + 3.5).toFixed(1)}" text-anchor="middle" font-size="10.5" font-weight="700" fill="#FFFFFF">${pctTxt}%</text>` : ''}
            `;
          }).join('');
          donutEl.innerHTML = `
            <svg viewBox="0 0 ${size} ${size}" class="w-[210px] h-[210px] apple-donut-reveal" role="img" aria-label="Phân hạng đối tác">
              ${arcs}
              <text x="${cx}" y="${cy - 3}" text-anchor="middle" font-size="22" font-weight="800" fill="#0F172A">${total}</text>
              <text x="${cx}" y="${cy + 14}" text-anchor="middle" font-size="10.5" fill="#64748B">Hồ sơ</text>
            </svg>
          `;
        }
      }
      if (legendEl) {
        legendEl.innerHTML = tierSegs.map(s => `
          <span class="inline-flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 rounded-full shrink-0" style="background:${s.color}"></span>
            <span>${escapeHtml(s.label)}</span>
            <span class="font-semibold text-slate-900 tabular-nums">(${s.count})</span>
          </span>
        `).join('');
      }
    }

    function initialsForName(name) {
      const words = String(name || 'DT').trim().split(/\s+/).filter(Boolean);
      if (words.length >= 2) return (words[words.length - 2][0] + words[words.length - 1][0]).toUpperCase();
      return String(name || 'DT').slice(0, 2).toUpperCase();
    }

    function renderDossierTable(preservePage = false) {
      if (!preservePage) STATE.dossierPage = 1;
