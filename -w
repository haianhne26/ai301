        <div class="flex items-center justify-end gap-3 pt-2">
          ${STATE.activeDossier ? `
            <button onclick="rerunStep2FromForm()" class="px-6 py-2.5 rounded-lg btn-glass-blue text-xs font-bold text-white flex items-center gap-2 transition">
              <i data-lucide="refresh-cw" class="w-4 h-4"></i> Cập nhật &amp; Đối chiếu
            </button>
          ` : `
            <button onclick="submitStep1Form()" class="px-6 py-2.5 rounded-lg btn-glass-blue text-xs font-bold text-white flex items-center gap-2 transition">
              <i data-lucide="check" class="w-4 h-4"></i> Lưu &amp; Đối chiếu
            </button>
