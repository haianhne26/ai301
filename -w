              <div class="grid grid-cols-1 gap-2">
                <button onclick="selectDirectorDecision('TIEP_TUC')" id="dec-btn-TIEP_TUC" class="px-4 py-2.5 rounded-lg text-xs font-bold text-left flex items-center justify-between transition ${curDecision === 'TIEP_TUC' ? 'btn-glass-green text-white' : 'liquid-pill text-slate-700'}">
                  <span>[TIẾP TỤC] · Mở mã đại lý</span>
                  <i data-lucide="check-circle-2" class="w-4 h-4"></i>
                </button>
                <button onclick="selectDirectorDecision('BO_SUNG_DIEU_KIEN')" id="dec-btn-BO_SUNG_DIEU_KIEN" class="px-4 py-2.5 rounded-lg text-xs font-bold text-left flex items-center justify-between transition ${curDecision === 'BO_SUNG_DIEU_KIEN' ? 'btn-glass-amber text-white' : 'liquid-pill text-slate-700'}">
                  <span>[BỔ SUNG ĐIỀU KIỆN]</span>
                  <i data-lucide="alert-circle" class="w-4 h-4"></i>
                </button>
                <button onclick="selectDirectorDecision('CHUA_TIEP_TUC')" id="dec-btn-CHUA_TIEP_TUC" class="px-4 py-2.5 rounded-lg text-xs font-bold text-left flex items-center justify-between transition ${curDecision === 'CHUA_TIEP_TUC' ? 'btn-glass-crimson text-white' : 'liquid-pill text-slate-700'}">
                  <span>[CHƯA TIẾP TỤC]</span>
                  <i data-lucide="x-circle" class="w-4 h-4"></i>
