    function selectDirectorDecision(code) {
      document.getElementById('selected-decision-input').value = code;
      ['TIEP_TUC', 'BO_SUNG_DIEU_KIEN', 'CHUA_TIEP_TUC'].forEach(c => {
        const btn = document.getElementById(`dec-btn-${c}`);
        if (!btn) return;
        const activeStyles = {
          TIEP_TUC: 'btn-glass-green text-white',
          BO_SUNG_DIEU_KIEN: 'btn-glass-amber text-white',
          CHUA_TIEP_TUC: 'btn-glass-crimson text-white',
        };
