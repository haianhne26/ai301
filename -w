    function simulateVerificationPass() {
      document.getElementById('v-kd-footfall').value = 35;
      document.getElementById('v-kd-rep').value = 5;
      document.getElementById('v-kd-confirmed').checked = true;
      document.getElementById('v-vh-ktv').value = 3;
      document.getElementById('v-vh-area').value = 28;
      document.getElementById('v-vh-sla').checked = true;
      document.getElementById('v-vh-tools').checked = true;
      document.getElementById('v-tc-cic').value = '1';
      showToast('Đã điền giả lập khảo sát đạt chuẩn — bấm "Cập nhật kết quả & Chấm lại điểm".', 'info');
    }

    function simulateVerificationWeakKtv() {
      document.getElementById('v-kd-footfall').value = 10;
      document.getElementById('v-kd-confirmed').checked = false;
      document.getElementById('v-vh-ktv').value = 0;
      document.getElementById('v-vh-area').value = 0;
      document.getElementById('v-vh-sla').checked = false;
      document.getElementById('v-vh-tools').checked = false;
      showToast('Đã điền giả lập 0 KTV thực tế — bấm "Cập nhật kết quả & Chấm lại điểm".', 'warning');
    }

    async function submitStep3Verification() {
      const cicGroup = parseInt(document.getElementById('v-tc-cic').value || '1', 10);
      const payload = {
        commercial: {
          verified_footfall_daily: parseInt(document.getElementById('v-kd-footfall').value || '0', 10),
          verified_feasible_monthly_billion: parseFloat(document.getElementById('v-kd-feasible').value || '0'),
          market_reputation_rating: parseInt(document.getElementById('v-kd-rep').value || '3', 10),
          sales_capacity_confirmed: Boolean(document.getElementById('v-kd-confirmed').checked),
          notes: document.getElementById('v-kd-notes').value,
        },
        operations: {
          verified_technicians_count: parseInt(document.getElementById('v-vh-ktv').value || '0', 10),
          verified_workshop_area_m2: parseFloat(document.getElementById('v-vh-area').value || '0'),
          sla_48h_signed: Boolean(document.getElementById('v-vh-sla').checked),
          has_diagnostic_tools: Boolean(document.getElementById('v-vh-tools').checked),
          notes: document.getElementById('v-vh-notes').value,
        },
        finance: {
          cic_group: cicGroup,
          cic_clean: cicGroup === 1,
          verified_bank_guarantee: Boolean(document.getElementById('v-tc-bg').checked),
          verified_guarantee_amount_million: parseFloat(document.getElementById('v-tc-bg-amt').value || '0'),
          credit_risk_rating: cicGroup >= 3 ? 'CRITICAL' : (cicGroup === 2 ? 'MEDIUM' : 'LOW'),
          notes: document.getElementById('v-tc-notes').value,
        },
      };
      try {
        const res = await apiFetch(`/api/dossiers/${STATE.activeDossier.dossier_id}/step3/verify`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        STATE.activeDossier = res.dossier;
        STATE.dossiers = res.dossiers;
        STATE.analytics = res.analytics;
        STATE.cockpitStep = 4;
        renderAll();
        renderCockpit();
        showToast('Đã cập nhật kết quả khảo sát 3 phòng ban & chấm lại điểm!', 'success');
      } catch (err) {
        showToast(err.message, 'error');
      }
    }

    // ----------------- STEP 4: 100-POINT SCORING & PHANTOM TRAP -----------------
    function renderStep4Html(d) {
      const sc = d.scoring_report || {};
      const bd = sc.breakdown || {};
      const finalScore = sc.final_score ?? 0;
      const strokeColor = finalScore >= 80 ? '#10B981' : (finalScore >= 65 ? '#2563EB' : (finalScore >= 50 ? '#F59E0B' : '#EF4444'));
      const r = 56, circ = 2 * Math.PI * r;
      const dashOffset = circ * (1 - Math.min(100, Math.max(0, finalScore)) / 100);

      const delta = sc.score_delta || 0;
      const deltaTag = delta > 0
        ? `<span class="text-emerald-600 font-semibold">+${delta}đ sau xác minh</span>`
        : delta < 0
          ? `<span class="text-rose-600 font-semibold">${delta}đ sau xác minh</span>`
          : `<span class="text-slate-500">Điểm sơ bộ: ${sc.initial_score}đ</span>`;

      const pillars = ['commercial', 'warranty', 'financial_legal', 'location_warehouse'].map(k => {
        const item = bd[k] || { score: 0, max: 25, label: k, notes: [] };
        const pct = Math.min(100, Math.round((item.score / item.max) * 100));
        return `
          <div class="liquid-panel rounded-xl p-4 space-y-2.5">
            <div class="flex items-center justify-between text-xs">
              <span class="font-bold text-slate-900">${escapeHtml(item.label)}</span>
              <span class="font-extrabold text-blue-600 tabular-nums">${item.score} / ${item.max}đ</span>
            </div>
            <div class="h-2.5 rounded-full spectrum-track">
              <div class="spectrum-glass-thumb js-animate-thumb" style="left:0%" data-target-left="${pct}%"></div>
            </div>
            <ul class="space-y-1 text-[11px] text-slate-600 pt-1">
              ${(item.notes || []).map(n => `<li>• ${escapeHtml(n)}</li>`).join('')}
            </ul>
          </div>
        `;
      }).join('');

      return `
        ${sc.phantom_commitment_alert ? `
          <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 flex items-start gap-3">
            <div class="w-9 h-9 rounded-full btn-glass-crimson flex items-center justify-center shrink-0 text-white">
              <i data-lucide="alert-octagon" class="w-4 h-4"></i>
            </div>
            <div class="text-xs space-y-1">
              <div class="font-bold text-rose-700">Bẫy cam kết ảo (-25đ phạt)</div>
              <p class="text-rose-600">${escapeHtml(sc.phantom_reason)}</p>
            </div>
          </div>
        ` : ''}

        ${(sc.severe_violations || []).length && !sc.phantom_commitment_alert ? `
          <div class="p-4 rounded-xl bg-rose-50 border border-rose-200 text-xs text-rose-700">
            <strong>Vi phạm nghiêm trọng (Tier D):</strong> ${escapeHtml(sc.severe_violations.join(' · '))}
          </div>
        ` : ''}

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 items-center">
          <div class="lg:col-span-4 liquid-panel rounded-xl p-5 flex flex-col items-center text-center">
            <div class="relative w-36 h-36 flex items-center justify-center">
              <svg class="w-36 h-36 -rotate-90" viewBox="0 0 132 132">
                <circle cx="66" cy="66" r="${r}" stroke="#E2E8F0" stroke-width="10" fill="none" />
                <circle class="js-animate-score-ring" cx="66" cy="66" r="${r}" stroke="${strokeColor}" stroke-width="10" fill="none" stroke-linecap="round" stroke-dasharray="${circ.toFixed(1)}" data-target-offset="${dashOffset.toFixed(1)}" style="stroke-dashoffset:${circ.toFixed(1)}; transition: stroke-dashoffset 0.72s var(--apple-spring);" />
              </svg>
              <div class="absolute inset-0 flex flex-col items-center justify-center">
                <span class="text-3xl font-extrabold text-slate-900 tabular-nums">${finalScore}</span>
                <span class="text-[11px] text-slate-500">/ 100 điểm</span>
              </div>
            </div>
            <div class="mt-2 space-y-1.5">
              <div>${tierBadgeHtml(sc.tier)}</div>
              <div class="text-xs font-semibold text-slate-800">${escapeHtml(sc.tier_action)}</div>
              <div class="text-[11px] text-slate-500">Tổng thô: ${sc.raw_score}đ · Phạt ảo: -${sc.penalty_points || 0}đ</div>
              <div class="text-[11px]">${deltaTag}</div>
            </div>
          </div>

          <div class="lg:col-span-8 grid grid-cols-1 sm:grid-cols-2 gap-3">
            ${pillars}
          </div>
        </div>

        <div class="flex items-center justify-between pt-2">
          <button onclick="jumpCockpitStep(3)" class="px-4 py-2 rounded-lg liquid-pill text-xs font-semibold text-slate-700">← Bước 3</button>
          <button onclick="jumpCockpitStep(5)" class="px-6 py-2.5 rounded-lg btn-glass-blue text-xs font-bold text-white flex items-center gap-2 transition">
            <span>Sang Bước 5 · Phê duyệt</span>
            <i data-lucide="arrow-right" class="w-4 h-4"></i>
          </button>
        </div>
      `;
    }

