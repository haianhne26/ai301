        setSidebarActive(sel.value === 'RISK' ? 'risk' : 'dashboard');
        renderDossierTable();
      }
      document.getElementById('dossier-table-card')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      if (window.innerWidth < 1024) toggleSidebar(false);
    }

    function clearQuickFilters() {
      ['filter-search', 'top-global-search'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.value = '';
      });
      const r = document.getElementById('filter-region');
      const t = document.getElementById('filter-tier');
      const rk = document.getElementById('filter-risk');
      if (r) r.value = 'ALL';
      if (t) t.value = 'ALL';
      if (rk) rk.value = 'ALL';
      setSidebarActive('dashboard');
      renderDossierTable();
    }

    function syncSearchFromTop(val) {
      const fs = document.getElementById('filter-search');
      if (fs && fs.value !== val) {
        fs.value = val;
        switchMainTab('dashboard');
        renderDossierTable();
      }
    }

    function openLatestForStep(targetStep) {
      if (window.innerWidth < 1024) toggleSidebar(false);
      if (!STATE.dossiers.length) {
        openNewIntakeModal();
        return;
      }
      const match = STATE.dossiers.find(d => d.current_step === targetStep) || STATE.dossiers[0];
      openDossierCockpit(match.dossier_id).then(() => {
        if (STATE.activeDossier) jumpCockpitStep(targetStep);
      });
    }

    function switchMainTab(tabName) {
      ['dashboard', 'geofence', 'policy', 'excel'].forEach(t => {
        const sec = document.getElementById(`main-tab-${t}`);
        if (!sec) return;
        const show = t === tabName;
        sec.classList.toggle('hidden', !show);
        if (show) {
          sec.classList.remove('apple-fade-up');
          void sec.offsetWidth;
          sec.classList.add('apple-fade-up');
        }
      });
      setSidebarActive(tabName);
      if (tabName === 'dashboard') {
        requestAnimationFrame(() => requestAnimationFrame(triggerVisualMetricsMotion));
      } else if (tabName === 'excel') {
        renderExcelWorkflow();
      }
      const meta = {
        dashboard: { title: 'Tổng quan Đối tác', crumb: 'Trang chủ / Thẩm định / Tổng quan' },
        geofence: { title: 'Địa bàn & Geofence', crumb: 'Trang chủ / Thẩm định / Địa bàn & GPS' },
        policy: { title: 'Quy chuẩn Chính sách', crumb: 'Trang chủ / Thẩm định / Chính sách' },
        excel: { title: 'Nhập Excel Đối tác', crumb: 'Trang chủ / Công cụ / Nhập Excel' },
      }[tabName] || { title: 'Tổng quan Đối tác', crumb: 'Trang chủ / Đối tác' };
      const titleEl = document.getElementById('page-title');
      const crumbEl = document.getElementById('page-breadcrumb');
      if (titleEl) titleEl.textContent = meta.title;
      if (crumbEl) crumbEl.textContent = meta.crumb;
    }

